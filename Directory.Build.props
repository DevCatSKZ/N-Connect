<Project>
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Standard für Bibliothek, Tests und Werkzeuge. Die Apps tragen ihre eigene Version: Windows in
         Switch2Pro.Bridge.csproj, Linux in SkzConnect.Linux.csproj, Android als ApplicationDisplayVersion. -->
    <Version>1.0.0</Version>
    <Company>devcatskz</Company>
    <Authors>devcatskz</Authors>
    <Product>SKZ Connect</Product>
    <Copyright>© 2026 devcatskz</Copyright>
  </PropertyGroup>
</Project>
