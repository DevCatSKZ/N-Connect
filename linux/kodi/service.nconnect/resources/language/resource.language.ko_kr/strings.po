msgstr "연결 중 …"

msgctxt "#30622"
msgid "SKZ Connect diagnostics"
msgstr "SKZ Connect 진단"

msgctxt "#30623"
msgid "[B]Everything is ready.[/B] Press SYNC on a controller to connect it."
msgstr "[B]모든 준비가 끝났습니다.[/B] 컨트롤러의 SYNC를 눌러 연결하세요."

msgctxt "#30624"
msgid "[B]Something is missing[/B] – see the red entries below."
msgstr "[B]빠진 것이 있습니다[/B] – 아래 빨간 항목을 확인하세요."

msgctxt "#30625"
msgid "The log is empty."
msgstr "로그가 비어 있습니다."

msgctxt "#30626"
