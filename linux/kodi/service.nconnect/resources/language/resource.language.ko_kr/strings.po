msgctxt "#30603"
msgid "{0} updates/s"
msgstr "초당 {0}회"

msgctxt "#30604"
msgid "No controller connected"
msgstr "연결된 컨트롤러 없음"

msgctxt "#30605"
msgid "Press SYNC (Switch 2) or the pairing button (other controllers). Already paired: press any button."
msgstr "SYNC(Switch 2) 또는 페어링 버튼(다른 컨트롤러)을 누르세요. 이미 페어링됨: 아무 버튼이나 누르세요."

msgctxt "#30606"
msgid "{0} found"
msgstr "{0} 발견"

msgctxt "#30607"
msgid "Paired with another device – press SYNC to use it here"
msgstr "다른 기기와 페어링됨 – 여기서 사용하려면 SYNC를 누르세요"

msgctxt "#30608"
msgid "Bluetooth is off"
msgstr "블루투스가 꺼져 있음"

msgctxt "#30609"
msgid "Open LibreELEC settings > Bluetooth and enable it"
msgstr "LibreELEC 설정 > 블루투스를 열고 켜세요"

msgctxt "#30610"
msgid "No Bluetooth adapter"
msgstr "블루투스 어댑터 없음"

msgctxt "#30611"
msgid "Plug in a Bluetooth adapter or enable the built-in one in the LibreELEC settings"
msgstr "블루투스 어댑터를 연결하거나 LibreELEC 설정에서 내장 어댑터를 켜세요"

msgctxt "#30612"
msgid "SKZ Connect is not running"
msgstr "SKZ Connect가 실행되고 있지 않음"

msgctxt "#30613"
msgid "Select to restart. If it keeps stopping, run the diagnostics."
msgstr "선택하면 다시 시작합니다. 계속 중지되면 진단을 실행하세요."

msgctxt "#30614"
msgid "Disconnect all controllers"
msgstr "모든 컨트롤러 연결 해제"

msgctxt "#30615"
msgid "How to connect a controller"
msgstr "컨트롤러 연결 방법"

msgctxt "#30616"
msgid "Run diagnostics"
msgstr "진단 실행"

msgctxt "#30617"
