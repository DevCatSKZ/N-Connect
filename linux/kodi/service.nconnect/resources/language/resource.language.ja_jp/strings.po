msgstr "Bluetooth がオフです"

msgctxt "#30609"
msgid "Open LibreELEC settings > Bluetooth and enable it"
msgstr "LibreELEC の設定 > Bluetooth を開いてオンにしてください"

msgctxt "#30610"
msgid "No Bluetooth adapter"
msgstr "Bluetooth アダプターがありません"

msgctxt "#30611"
msgid "Plug in a Bluetooth adapter or enable the built-in one in the LibreELEC settings"
msgstr "Bluetooth アダプターを接続するか、LibreELEC の設定で内蔵のものを有効にしてください"

msgctxt "#30612"
