msgid "Notifications"
msgstr "通知"

msgctxt "#30410"
msgid "Show notifications"
msgstr "通知を表示"

msgctxt "#30411"
msgid "Shows a short message when a controller connects or disconnects. Errors are always shown."
msgstr "コントローラーの接続・切断時に短いメッセージを表示します。エラーは常に表示されます。"

msgctxt "#30500"
msgid "Help"
msgstr "ヘルプ"

msgctxt "#30501"
msgid "N-Connect"
msgstr "N-Connect"

msgctxt "#30510"
msgid "Controllers and status"
msgstr "コントローラーと状態"

msgctxt "#30511"
msgid "Shows connected controllers with battery level and lets you disconnect them."
msgstr "接続中のコントローラーとバッテリー残量を表示し、切断できます。"

msgctxt "#30512"
msgid "How to connect a controller"
msgstr "コントローラーの接続方法"

msgctxt "#30513"
msgid "Step-by-step guide for the first connection and for reconnecting."
msgstr "初回接続と再接続の手順ガイド。"

msgctxt "#30514"
msgid "Run diagnostics"
msgstr "診断を実行"

msgctxt "#30515"
msgid "Checks Bluetooth and the virtual controller and shows what is missing."
msgstr "Bluetooth と仮想コントローラーを確認し、足りないものを表示します。"

msgctxt "#30516"
msgid "Show log"
msgstr "ログを表示"

msgctxt "#30517"
msgid "The latest N-Connect log entries – useful when reporting a problem."
msgstr "N-Connect の最新のログ – 問題を報告するときに役立ちます。"

