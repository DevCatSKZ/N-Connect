msgid "{0} updates/s"
msgstr "{0} 回/秒"

msgctxt "#30604"
msgid "No controller connected"
msgstr "コントローラーが接続されていません"

msgctxt "#30605"
msgid "Press SYNC (Switch 2) or the pairing button (other controllers). Already paired: press any button."
msgstr "SYNC（Switch 2）またはペアリングボタン（ほかのコントローラー）を押してください。ペアリング済み: いずれかのボタンを押してください。"

msgctxt "#30606"
msgid "{0} found"
msgstr "{0} が見つかりました"

msgctxt "#30607"
msgid "Paired with another device – press SYNC to use it here"
msgstr "別の機器とペアリング済み – ここで使うには SYNC を押してください"

msgctxt "#30608"
