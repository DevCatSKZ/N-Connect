msgid "Context menu"
msgstr "上下文菜单"

msgctxt "#30434"
msgid "Information"
msgstr "信息"

msgctxt "#30435"
msgid "Play/pause"
msgstr "播放/暂停"

msgctxt "#30436"
msgid "Stop"
msgstr "停止"

msgctxt "#30437"
msgid "Mute"
msgstr "静音"

msgctxt "#30438"
msgid "Power menu"
msgstr "电源菜单"

msgctxt "#30439"
