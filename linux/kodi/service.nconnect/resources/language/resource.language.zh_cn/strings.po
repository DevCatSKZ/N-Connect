msgctxt "#30023"
msgid "{0} paired – from now on a button press reconnects it"
msgstr "{0} 已配对 – 以后按任意键即可连接"

msgctxt "#30024"
msgid "{0} connected"
msgstr "{0} 已连接"

msgctxt "#30025"
