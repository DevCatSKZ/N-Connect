msgctxt "#30023"
msgid "{0} paired – from now on a button press reconnects it"
msgstr "{0} emparejado – a partir de ahora basta con pulsar un botón"

msgctxt "#30024"
msgid "{0} connected"
msgstr "{0} conectado"

msgctxt "#30025"
msgid "{0} disconnected"
msgstr "{0} desconectado"

msgctxt "#30026"
msgid "{0}: pairing failed – put it into pairing mode again"
msgstr "{0}: error de emparejamiento – vuelve a ponerlo en modo de emparejamiento"

msgctxt "#30332"
msgid "Pair other controllers automatically"
msgstr "Emparejar otros mandos automáticamente"

msgctxt "#30333"
msgid "Xbox, PlayStation, Switch 1, 8BitDo and other gamepads in pairing mode are paired and connected automatically – no need to open the Bluetooth settings. Headphones, keyboards and other devices are never touched."
msgstr "Los mandos de Xbox, PlayStation, Switch 1, 8BitDo y otros en modo de emparejamiento se emparejan y conectan automáticamente, sin pasar por los ajustes de Bluetooth. Auriculares, teclados y otros dispositivos nunca se tocan."

msgctxt "#30651"
msgid "connected"
msgstr "conectado"

msgctxt "#30652"
msgid "not connected – press a button on the controller"
msgstr "no conectado – pulsa un botón del mando"

msgctxt "#30653"
msgid "Forget controller"
msgstr "Olvidar mando"

msgctxt "#30654"
msgid "Remove the pairing of {0}? To use it again, put it into pairing mode."
msgstr "¿Eliminar el emparejamiento de {0}? Para volver a usarlo, ponlo en modo de emparejamiento."

msgctxt "#30027"
msgid "Searching for controllers for 2 minutes …"
msgstr "Buscando mandos durante 2 minutos …"

msgctxt "#30334"
msgid "Search for controllers continuously"
msgstr "Buscar mandos continuamente"

msgctxt "#30335"
msgid "N-Connect keeps searching in the background, so any controller can be paired with SYNC at any time and Switch 2 controllers reconnect with a button press. When off, it only searches after \"Search for controllers now\"; paired Xbox/PlayStation controllers still reconnect on their own."
msgstr "N-Connect busca continuamente en segundo plano: cualquier mando se puede emparejar con SYNC en cualquier momento y los mandos de Switch 2 se reconectan con un botón. Desactivado: solo busca tras «Buscar mandos ahora»; los mandos de Xbox/PlayStation emparejados se reconectan solos."

msgctxt "#30632"
msgid "Search for controllers now"
msgstr "Buscar mandos ahora"

msgctxt "#30633"
msgid "Background search is off – searches for 2 minutes"
msgstr "La búsqueda en segundo plano está desactivada – busca durante 2 minutos"

msgctxt "#30028"
msgid "{0}: battery low ({1} %) – charge soon"
msgstr "{0}: batería baja ({1} %) – cárgalo pronto"

msgctxt "#30412"
msgid "Low battery warning"
msgstr "Aviso de batería baja"

msgctxt "#30413"
msgid "Shows a message when a controller's battery drops to 20 % and again at 10 %."
msgstr "Muestra un mensaje cuando la batería de un mando baja al 20 % y de nuevo al 10 %."

