msgctxt "#30140"
msgid "Emulators (motion control)"
msgstr "Emuladores (control por movimiento)"

msgctxt "#30141"
msgid "Gyro for emulators (DSU/Cemuhook)"
msgstr "Giroscopio para emuladores (DSU/Cemuhook)"

msgctxt "#30142"
msgid "Emulators such as Dolphin, Cemu or Citra receive motion, gyro and buttons of players 1–4 (port 26760) – for motion controls like on the console."
msgstr "Emuladores como Dolphin, Cemu o Citra reciben el movimiento, el giroscopio y los botones de los jugadores 1–4 (puerto 26760), para controlar con movimiento como en la consola."

msgctxt "#30143"
msgid "Also for other devices on the home network"
msgstr "También para otros dispositivos de la red doméstica"

msgctxt "#30144"
msgid "Lets an emulator on another device (e.g. Cemu on a PC) use the motion data of controllers connected here. Only enable on a trusted home network."
msgstr "Permite que un emulador en otro dispositivo (p. ej. Cemu en un PC) use los datos de movimiento de los mandos conectados aquí. Actívalo solo en una red doméstica de confianza."
