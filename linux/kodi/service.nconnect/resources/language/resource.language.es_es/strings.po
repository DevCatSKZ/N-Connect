msgstr "N-Connect"

msgctxt "#30510"
msgid "Controllers and status"
msgstr "Mandos y estado"

msgctxt "#30511"
msgid "Shows connected controllers with battery level and lets you disconnect them."
msgstr "Muestra los mandos conectados con su batería y permite desconectarlos."

msgctxt "#30512"
msgid "How to connect a controller"
msgstr "Cómo conectar un mando"

msgctxt "#30513"
msgid "Step-by-step guide for the first connection and for reconnecting."
msgstr "Guía paso a paso para la primera conexión y la reconexión."

msgctxt "#30514"
msgid "Run diagnostics"
msgstr "Ejecutar diagnóstico"

msgctxt "#30515"
msgid "Checks Bluetooth and the virtual controller and shows what is missing."
msgstr "Comprueba el Bluetooth y el mando virtual y muestra lo que falta."

msgctxt "#30516"
msgid "Show log"
msgstr "Mostrar registro"

msgctxt "#30517"
msgid "The latest N-Connect log entries – useful when reporting a problem."
msgstr "Las últimas entradas del registro de N-Connect – útiles al informar de un problema."

