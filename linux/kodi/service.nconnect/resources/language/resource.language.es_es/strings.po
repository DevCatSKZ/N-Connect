msgctxt "#30010"
msgid "Player {0}: {1} connected"
msgstr "Jugador {0}: {1} conectado"

msgctxt "#30011"
msgid "Joy-Con pair ready (player {0})"
msgstr "Par de Joy-Con listo (jugador {0})"

msgctxt "#30012"
msgid "Player {0}: {1} disconnected"
msgstr "Jugador {0}: {1} desconectado"

msgctxt "#30013"
msgid "{0} is paired with another device – press SYNC to use it here"
msgstr "{0} está emparejado con otro dispositivo – pulsa SYNC para usarlo aquí"

msgctxt "#30014"
msgid "{0}: connection failed – press SYNC and try again"
msgstr "{0}: error de conexión – pulsa SYNC e inténtalo de nuevo"

msgctxt "#30015"
msgid "Bluetooth is off – enable it in the LibreELEC settings"
msgstr "Bluetooth está desactivado – actívalo en los ajustes de LibreELEC"

msgctxt "#30016"
msgid "No Bluetooth adapter found"
msgstr "No se encontró ningún adaptador Bluetooth"

msgctxt "#30017"
msgid "Virtual controller could not be created – run the diagnostics"
msgstr "No se pudo crear el mando virtual – ejecuta el diagnóstico"

msgctxt "#30018"
msgid "N-Connect keeps stopping – see the log in the add-on settings"
msgstr "N-Connect se detiene una y otra vez – consulta el registro en los ajustes del add-on"

msgctxt "#30022"
msgid "This processor is not supported ({0})"
msgstr "Este procesador no es compatible ({0})"

msgctxt "#30100"
msgid "Controller"
msgstr "Mando"

msgctxt "#30101"
msgid "Buttons and sticks"
msgstr "Botones y sticks"

msgctxt "#30102"
msgid "Joy-Con"
msgstr "Joy-Con"

msgctxt "#30103"
msgid "Gyro aiming"
msgstr "Apuntado con giroscopio"

msgctxt "#30110"
msgid "Button layout"
msgstr "Distribución de botones"

msgctxt "#30111"
msgid "How the Nintendo face buttons are passed on as Xbox buttons. By position: the bottom button acts as A, like on an Xbox controller – recommended for Kodi and most games. As labelled: A stays A (right), B stays B (bottom), like on the Switch."
msgstr "Cómo se transmiten los botones de Nintendo como botones de Xbox. Por posición: el botón inferior actúa como A, como en un mando de Xbox – recomendado para Kodi y la mayoría de los juegos. Según la etiqueta: A sigue siendo A (derecha), B sigue siendo B (abajo), como en la Switch."

msgctxt "#30112"
msgid "By position (Xbox)"
msgstr "Por posición (Xbox)"

msgctxt "#30113"
msgid "As labelled (Nintendo)"
msgstr "Según la etiqueta (Nintendo)"

msgctxt "#30114"
msgid "Stick dead zone"
msgstr "Zona muerta del stick"

msgctxt "#30115"
msgid "Small stick movements inside this range are ignored. Increase it if the menu drifts on its own."
msgstr "Se ignoran los movimientos pequeños del stick dentro de este rango. Auméntala si el menú se desplaza solo."

msgctxt "#30120"
msgid "Combine two Joy-Con into one controller"
msgstr "Combinar dos Joy-Con en un mando"

msgctxt "#30121"
msgid "A left and a right Joy-Con act as one full controller. Turn off to use each Joy-Con on its own (held sideways) for two players."
msgstr "Un Joy-Con izquierdo y uno derecho forman un mando completo. Desactívalo para usar cada Joy-Con por separado (en horizontal) para dos jugadores."

msgctxt "#30130"
msgid "Gyro moves the right stick"
msgstr "El giroscopio mueve el stick derecho"

msgctxt "#30131"
msgid "Tilting the controller moves the right stick – for precise aiming in games. While aiming: only while ZL is held."
msgstr "Inclinar el mando mueve el stick derecho – para apuntar con precisión. Al apuntar: solo mientras se mantiene ZL."

msgctxt "#30132"
msgid "Off"
msgstr "Desactivado"

msgctxt "#30133"
msgid "Always"
msgstr "Siempre"

msgctxt "#30134"
msgid "While aiming (ZL held)"
msgstr "Al apuntar (ZL pulsado)"

msgctxt "#30135"
msgid "Gyro speed for full stick (°/s)"
msgstr "Velocidad del giroscopio para el stick completo (°/s)"

msgctxt "#30136"
msgid "Turning speed that moves the stick all the way. Lower values make the gyro more sensitive."
msgstr "Velocidad de giro que mueve el stick por completo. Los valores bajos hacen el giroscopio más sensible."

msgctxt "#30137"
msgid "Invert gyro up/down"
msgstr "Invertir giroscopio arriba/abajo"

msgctxt "#30138"
msgid "Tilting forward looks up instead of down."
msgstr "Inclinar hacia delante mira hacia arriba en lugar de hacia abajo."

msgctxt "#30200"
msgid "Rumble"
msgstr "Vibración"

msgctxt "#30201"
msgid "Rumble"
msgstr "Vibración"

msgctxt "#30210"
msgid "Rumble"
msgstr "Vibración"

msgctxt "#30211"
msgid "Games can make the controller vibrate."
msgstr "Los juegos pueden hacer vibrar el mando."

msgctxt "#30212"
msgid "Strength"
msgstr "Intensidad"

msgctxt "#30213"
msgid "How strongly the controller vibrates."
msgstr "Con qué fuerza vibra el mando."

msgctxt "#30300"
msgid "Connection"
msgstr "Conexión"

msgctxt "#30301"
msgid "Pairing"
msgstr "Emparejamiento"

msgctxt "#30302"
msgid "Battery saving"
msgstr "Ahorro de batería"

msgctxt "#30303"
msgid "Advanced"
msgstr "Avanzado"

msgctxt "#30310"
msgid "Remember controllers (pair in SYNC mode)"
msgstr "Recordar mandos (emparejar en modo SYNC)"

msgctxt "#30311"
msgid "When you press SYNC, the controller is paired with this device. After that, any button reconnects it. A controller remembers only one device – to use it on the Switch 2 or a PC again, press SYNC there."
msgstr "Al pulsar SYNC, el mando se empareja con este dispositivo. Después, cualquier botón lo vuelve a conectar. Un mando solo recuerda un dispositivo – para volver a usarlo en la Switch 2 o en un PC, pulsa SYNC allí."

msgctxt "#30312"
msgid "Show player number on the LEDs"
msgstr "Mostrar el número de jugador en los LED"

msgctxt "#30313"
msgid "The controller lights show which player it is."
msgstr "Las luces del mando indican qué jugador es."

msgctxt "#30314"
msgid "Short vibration when connected"
msgstr "Vibración breve al conectar"

msgctxt "#30315"
msgid "The controller clicks briefly once it is ready."
msgstr "El mando hace un breve clic en cuanto está listo."

msgctxt "#30316"
msgid "Disconnect when unused"
msgstr "Desconectar si no se usa"

msgctxt "#30317"
msgid "Disconnects a controller after this time without input to save its battery. Press any button to reconnect."
msgstr "Desconecta un mando tras este tiempo sin uso para ahorrar batería. Pulsa cualquier botón para reconectar."

msgctxt "#30320"
msgid "Never"
msgstr "Nunca"

msgctxt "#30321"
msgid "After 5 minutes"
msgstr "Tras 5 minutos"

msgctxt "#30322"
msgid "After 10 minutes"
msgstr "Tras 10 minutos"

msgctxt "#30323"
msgid "After 15 minutes"
msgstr "Tras 15 minutos"

msgctxt "#30324"
msgid "After 30 minutes"
msgstr "Tras 30 minutos"

msgctxt "#30325"
msgid "After 60 minutes"
msgstr "Tras 60 minutos"

msgctxt "#30330"
msgid "Bluetooth adapter"
msgstr "Adaptador Bluetooth"

msgctxt "#30331"
msgid "Leave empty to use the first adapter. Only needed with more than one adapter, e.g. hci1 for a USB stick."
msgstr "Déjalo vacío para usar el primer adaptador. Solo es necesario con varios adaptadores, p. ej. hci1 para una llave USB."

msgctxt "#30400"
msgid "Kodi"
msgstr "Kodi"

msgctxt "#30401"
msgid "Notifications"
msgstr "Notificaciones"

msgctxt "#30410"
msgid "Show notifications"
msgstr "Mostrar notificaciones"

msgctxt "#30411"
msgid "Shows a short message when a controller connects or disconnects. Errors are always shown."
msgstr "Muestra un mensaje breve al conectar o desconectar un mando. Los errores se muestran siempre."

msgctxt "#30500"
msgid "Help"
msgstr "Ayuda"

