msgctxt "#30010"
msgid "Player {0}: {1} connected"
msgstr "Jogador {0}: {1} ligado"

msgctxt "#30011"
msgid "Joy-Con pair ready (player {0})"
msgstr "Par de Joy-Con pronto (jogador {0})"

msgctxt "#30012"
msgid "Player {0}: {1} disconnected"
msgstr "Jogador {0}: {1} desligado"

msgctxt "#30013"
msgid "{0} is paired with another device – press SYNC to use it here"
msgstr "{0} está emparelhado com outro dispositivo – prima SYNC para o usar aqui"

msgctxt "#30014"
msgid "{0}: connection failed – press SYNC and try again"
msgstr "{0}: falha na ligação – prima SYNC e tente novamente"

msgctxt "#30015"
msgid "Bluetooth is off – enable it in the LibreELEC settings"
msgstr "O Bluetooth está desativado – ative-o nas definições do LibreELEC"

msgctxt "#30016"
msgid "No Bluetooth adapter found"
msgstr "Nenhum adaptador Bluetooth encontrado"

msgctxt "#30017"
msgid "Virtual controller could not be created – run the diagnostics"
msgstr "Não foi possível criar o comando virtual – execute o diagnóstico"

msgctxt "#30018"
msgid "N-Connect keeps stopping – see the log in the add-on settings"
msgstr "O N-Connect para constantemente – veja o registo nas definições do add-on"

msgctxt "#30022"
msgid "This processor is not supported ({0})"
msgstr "Este processador não é suportado ({0})"

msgctxt "#30100"
msgid "Controller"
msgstr "Comando"

msgctxt "#30101"
msgid "Buttons and sticks"
msgstr "Botões e analógicos"

msgctxt "#30102"
msgid "Joy-Con"
msgstr "Joy-Con"

msgctxt "#30103"
msgid "Gyro aiming"
msgstr "Mira por giroscópio"

msgctxt "#30110"
msgid "Button layout"
msgstr "Disposição dos botões"

msgctxt "#30111"
msgid "How the Nintendo face buttons are passed on as Xbox buttons. By position: the bottom button acts as A, like on an Xbox controller – recommended for Kodi and most games. As labelled: A stays A (right), B stays B (bottom), like on the Switch."
msgstr "Como os botões Nintendo são transmitidos como botões Xbox. Por posição: o botão de baixo funciona como A, como num comando Xbox – recomendado para o Kodi e a maioria dos jogos. Conforme a etiqueta: A continua A (direita), B continua B (baixo), como na Switch."

msgctxt "#30112"
msgid "By position (Xbox)"
msgstr "Por posição (Xbox)"

msgctxt "#30113"
msgid "As labelled (Nintendo)"
msgstr "Conforme a etiqueta (Nintendo)"

msgctxt "#30114"
msgid "Stick dead zone"
msgstr "Zona morta do analógico"

msgctxt "#30115"
msgid "Small stick movements inside this range are ignored. Increase it if the menu drifts on its own."
msgstr "Pequenos movimentos do analógico dentro desta zona são ignorados. Aumente se o menu se mover sozinho."

msgctxt "#30120"
msgid "Combine two Joy-Con into one controller"
msgstr "Combinar dois Joy-Con num comando"

msgctxt "#30121"
msgid "A left and a right Joy-Con act as one full controller. Turn off to use each Joy-Con on its own (held sideways) for two players."
msgstr "Um Joy-Con esquerdo e um direito formam um comando completo. Desative para usar cada Joy-Con sozinho (na horizontal) para dois jogadores."

msgctxt "#30130"
msgid "Gyro moves the right stick"
msgstr "O giroscópio move o analógico direito"

msgctxt "#30131"
msgid "Tilting the controller moves the right stick – for precise aiming in games. While aiming: only while ZL is held."
msgstr "Inclinar o comando move o analógico direito – para apontar com precisão. Ao apontar: apenas enquanto ZL estiver premido."

msgctxt "#30132"
msgid "Off"
msgstr "Desativado"

msgctxt "#30133"
msgid "Always"
msgstr "Sempre"

msgctxt "#30134"
msgid "While aiming (ZL held)"
msgstr "Ao apontar (ZL premido)"

msgctxt "#30135"
msgid "Gyro speed for full stick (°/s)"
msgstr "Velocidade do giroscópio para o analógico total (°/s)"

msgctxt "#30136"
msgid "Turning speed that moves the stick all the way. Lower values make the gyro more sensitive."
msgstr "Velocidade de rotação que move o analógico até ao fim. Valores mais baixos tornam o giroscópio mais sensível."

msgctxt "#30137"
msgid "Invert gyro up/down"
msgstr "Inverter giroscópio cima/baixo"

msgctxt "#30138"
msgid "Tilting forward looks up instead of down."
msgstr "Inclinar para a frente olha para cima em vez de para baixo."

msgctxt "#30200"
msgid "Rumble"
msgstr "Vibração"

msgctxt "#30201"
msgid "Rumble"
msgstr "Vibração"

msgctxt "#30210"
msgid "Rumble"
msgstr "Vibração"

msgctxt "#30211"
msgid "Games can make the controller vibrate."
msgstr "Os jogos podem fazer o comando vibrar."

msgctxt "#30212"
msgid "Strength"
msgstr "Intensidade"

msgctxt "#30213"
msgid "How strongly the controller vibrates."
msgstr "Com que força o comando vibra."

msgctxt "#30300"
msgid "Connection"
msgstr "Ligação"

msgctxt "#30301"
msgid "Pairing"
msgstr "Emparelhamento"

msgctxt "#30302"
msgid "Battery saving"
msgstr "Poupança de bateria"

msgctxt "#30303"
msgid "Advanced"
msgstr "Avançado"

msgctxt "#30310"
msgid "Remember controllers (pair in SYNC mode)"
msgstr "Memorizar comandos (emparelhar em modo SYNC)"

msgctxt "#30311"
msgid "When you press SYNC, the controller is paired with this device. After that, any button reconnects it. A controller remembers only one device – to use it on the Switch 2 or a PC again, press SYNC there."
msgstr "Ao premir SYNC, o comando é emparelhado com este dispositivo. Depois, qualquer botão volta a ligá-lo. Um comando só memoriza um dispositivo – para o usar de novo na Switch 2 ou num PC, prima SYNC lá."

msgctxt "#30312"
msgid "Show player number on the LEDs"
msgstr "Mostrar o número do jogador nos LED"

msgctxt "#30313"
msgid "The controller lights show which player it is."
msgstr "As luzes do comando indicam qual jogador é."

msgctxt "#30314"
msgid "Short vibration when connected"
msgstr "Vibração curta ao ligar"

msgctxt "#30315"
msgid "The controller clicks briefly once it is ready."
msgstr "O comando dá um breve clique assim que estiver pronto."

msgctxt "#30316"
msgid "Disconnect when unused"
msgstr "Desligar quando não usado"

msgctxt "#30317"
msgid "Disconnects a controller after this time without input to save its battery. Press any button to reconnect."
msgstr "Desliga um comando após este tempo sem utilização para poupar bateria. Prima qualquer botão para voltar a ligar."

msgctxt "#30320"
msgid "Never"
msgstr "Nunca"

msgctxt "#30321"
msgid "After 5 minutes"
msgstr "Após 5 minutos"

msgctxt "#30322"
msgid "After 10 minutes"
msgstr "Após 10 minutos"

msgctxt "#30323"
msgid "After 15 minutes"
msgstr "Após 15 minutos"

msgctxt "#30324"
msgid "After 30 minutes"
msgstr "Após 30 minutos"

msgctxt "#30325"
msgid "After 60 minutes"
msgstr "Após 60 minutos"

msgctxt "#30330"
msgid "Bluetooth adapter"
msgstr "Adaptador Bluetooth"

msgctxt "#30331"
msgid "Leave empty to use the first adapter. Only needed with more than one adapter, e.g. hci1 for a USB stick."
msgstr "Deixe vazio para usar o primeiro adaptador. Só é necessário com vários adaptadores, p. ex. hci1 para uma pen USB."

msgctxt "#30400"
msgid "Kodi"
msgstr "Kodi"

msgctxt "#30401"
msgid "Notifications"
msgstr "Notificações"

msgctxt "#30410"
msgid "Show notifications"
msgstr "Mostrar notificações"

msgctxt "#30411"
msgid "Shows a short message when a controller connects or disconnects. Errors are always shown."
msgstr "Mostra uma breve mensagem quando um comando se liga ou desliga. Os erros são sempre mostrados."

msgctxt "#30500"
msgid "Help"
msgstr "Ajuda"

msgctxt "#30501"
msgid "N-Connect"
msgstr "N-Connect"

msgctxt "#30510"
msgid "Controllers and status"
msgstr "Comandos e estado"

msgctxt "#30511"
msgid "Shows connected controllers with battery level and lets you disconnect them."
msgstr "Mostra os comandos ligados com a bateria e permite desligá-los."

msgctxt "#30512"
msgid "How to connect a controller"
msgstr "Como ligar um comando"

msgctxt "#30513"
msgid "Step-by-step guide for the first connection and for reconnecting."
msgstr "Guia passo a passo para a primeira ligação e para voltar a ligar."

msgctxt "#30514"
msgid "Run diagnostics"
msgstr "Executar diagnóstico"

msgctxt "#30515"
msgid "Checks Bluetooth and the virtual controller and shows what is missing."
msgstr "Verifica o Bluetooth e o comando virtual e mostra o que falta."

msgctxt "#30516"
msgid "Show log"
msgstr "Mostrar registo"

msgctxt "#30517"
msgid "The latest N-Connect log entries – useful when reporting a problem."
msgstr "As últimas entradas do registo do N-Connect – úteis ao comunicar um problema."

