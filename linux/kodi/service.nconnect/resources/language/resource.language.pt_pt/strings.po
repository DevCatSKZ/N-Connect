msgstr "Botão C (Switch 2)"

msgctxt "#30423"
msgid "GL back button (Pro Controller 2)"
msgstr "Botão traseiro GL (Pro Controller 2)"

msgctxt "#30424"
msgid "GR back button (Pro Controller 2)"
msgstr "Botão traseiro GR (Pro Controller 2)"

msgctxt "#30425"
msgid "What the button does in Kodi – in addition to its normal function in games."
msgstr "O que o botão faz no Kodi, além da sua função normal nos jogos."

msgctxt "#30430"
