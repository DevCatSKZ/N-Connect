msgctxt "#30023"
msgid "{0} paired – from now on a button press reconnects it"
msgstr "{0} emparelhado – a partir de agora basta premir um botão"

msgctxt "#30024"
msgid "{0} connected"
msgstr "{0} ligado"

msgctxt "#30025"
msgid "{0} disconnected"
msgstr "{0} desligado"

msgctxt "#30026"
msgid "{0}: pairing failed – put it into pairing mode again"
msgstr "{0}: falha no emparelhamento – coloque-o novamente em modo de emparelhamento"

msgctxt "#30332"
msgid "Pair other controllers automatically"
msgstr "Emparelhar outros comandos automaticamente"

msgctxt "#30333"
msgid "Xbox, PlayStation, Switch 1, 8BitDo and other gamepads in pairing mode are paired and connected automatically – no need to open the Bluetooth settings. Headphones, keyboards and other devices are never touched."
msgstr "Comandos Xbox, PlayStation, Switch 1, 8BitDo e outros em modo de emparelhamento são emparelhados e ligados automaticamente, sem passar pelas definições Bluetooth. Auscultadores, teclados e outros dispositivos nunca são tocados."

msgctxt "#30651"
msgid "connected"
msgstr "ligado"

msgctxt "#30652"
msgid "not connected – press a button on the controller"
msgstr "não ligado – prima um botão no comando"

msgctxt "#30653"
msgid "Forget controller"
msgstr "Esquecer comando"

msgctxt "#30654"
msgid "Remove the pairing of {0}? To use it again, put it into pairing mode."
msgstr "Remover o emparelhamento de {0}? Para o voltar a usar, coloque-o em modo de emparelhamento."

msgctxt "#30027"
msgid "Searching for controllers for 2 minutes …"
msgstr "A procurar comandos durante 2 minutos …"

msgctxt "#30334"
msgid "Search for controllers continuously"
msgstr "Procurar comandos continuamente"

msgctxt "#30335"
msgid "N-Connect keeps searching in the background, so any controller can be paired with SYNC at any time and Switch 2 controllers reconnect with a button press. When off, it only searches after \"Search for controllers now\"; paired Xbox/PlayStation controllers still reconnect on their own."
msgstr "O N-Connect procura continuamente em segundo plano: qualquer comando pode ser emparelhado com SYNC a qualquer momento e os comandos Switch 2 voltam a ligar-se com um botão. Desativado: só procura após «Procurar comandos agora»; comandos Xbox/PlayStation emparelhados voltam a ligar-se sozinhos."

msgctxt "#30632"
msgid "Search for controllers now"
msgstr "Procurar comandos agora"

msgctxt "#30633"
msgid "Background search is off – searches for 2 minutes"
msgstr "Procura em segundo plano desativada – procura durante 2 minutos"

msgctxt "#30028"
msgid "{0}: battery low ({1} %) – charge soon"
msgstr "{0}: bateria fraca ({1} %) – carregue em breve"

msgctxt "#30412"
msgid "Low battery warning"
msgstr "Aviso de bateria fraca"

msgctxt "#30413"
msgid "Shows a message when a controller's battery drops to 20 % and again at 10 %."
msgstr "Mostra uma mensagem quando a bateria de um comando desce para 20 % e novamente para 10 %."

msgctxt "#30420"
msgid "Controller buttons in Kodi"
msgstr "Botões do comando no Kodi"

msgctxt "#30421"
