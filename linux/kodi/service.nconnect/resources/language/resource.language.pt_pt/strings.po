msgstr "Ecrã inteiro"

msgctxt "#30140"
msgid "Emulators (motion control)"
msgstr "Emuladores (controlo por movimento)"

msgctxt "#30141"
msgid "Gyro for emulators (DSU/Cemuhook)"
msgstr "Giroscópio para emuladores (DSU/Cemuhook)"

msgctxt "#30142"
msgid "Emulators such as Dolphin, Cemu or Citra receive motion, gyro and buttons of players 1–4 (port 26760) – for motion controls like on the console."
msgstr "Emuladores como Dolphin, Cemu ou Citra recebem o movimento, o giroscópio e os botões dos jogadores 1–4 (porta 26760), para controlo por movimento como na consola."

msgctxt "#30143"
msgid "Also for other devices on the home network"
msgstr "Também para outros dispositivos da rede doméstica"

msgctxt "#30144"
msgid "Lets an emulator on another device (e.g. Cemu on a PC) use the motion data of controllers connected here. Only enable on a trusted home network."
msgstr "Permite que um emulador noutro dispositivo (p. ex. Cemu num PC) use os dados de movimento dos comandos ligados aqui. Ative apenas numa rede doméstica de confiança."
