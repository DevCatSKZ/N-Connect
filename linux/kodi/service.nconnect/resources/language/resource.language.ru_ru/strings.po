msgid "Details"
msgstr "Подробности"

msgctxt "#30621"
msgid "Connecting …"
msgstr "Подключение …"

msgctxt "#30622"
msgid "N-Connect diagnostics"
msgstr "Диагностика N-Connect"

msgctxt "#30623"
msgid "[B]Everything is ready.[/B] Press SYNC on a controller to connect it."
msgstr "[B]Всё готово.[/B] Нажмите SYNC на контроллере, чтобы подключить его."

msgctxt "#30624"
msgid "[B]Something is missing[/B] – see the red entries below."
msgstr "[B]Чего-то не хватает[/B] – см. красные строки ниже."

msgctxt "#30625"
msgid "The log is empty."
msgstr "Журнал пуст."

msgctxt "#30626"
msgid "Serial number"
msgstr "Серийный номер"

msgctxt "#30627"
msgid "Firmware"
msgstr "Прошивка"

msgctxt "#30628"
msgid "Address"
msgstr "Адрес"

msgctxt "#30629"
msgid "N-Connect log"
msgstr "Журнал N-Connect"

msgctxt "#30630"
msgid "Waiting for Bluetooth …"
msgstr "Ожидание Bluetooth …"

msgctxt "#30631"
msgid "N-Connect is starting …"
msgstr "N-Connect запускается …"

msgctxt "#30640"
msgid "Virtual controller"
msgstr "Виртуальный контроллер"

msgctxt "#30641"
msgid "Bluetooth service"
msgstr "Служба Bluetooth"

msgctxt "#30642"
msgid "Bluetooth adapter"
msgstr "Адаптер Bluetooth"

msgctxt "#30643"
msgid "Low latency"
msgstr "Низкая задержка"

msgctxt "#30644"
msgid "Settings file"
msgstr "Файл настроек"

msgctxt "#30645"
msgid "Checking Bluetooth and the virtual controller …"
msgstr "Проверка Bluetooth и виртуального контроллера …"

msgctxt "#30023"
msgid "{0} paired – from now on a button press reconnects it"
msgstr "{0} сопряжён – теперь достаточно нажать кнопку"

msgctxt "#30024"
msgid "{0} connected"
msgstr "{0} подключён"

msgctxt "#30025"
msgid "{0} disconnected"
msgstr "{0} отключён"

msgctxt "#30026"
msgid "{0}: pairing failed – put it into pairing mode again"
msgstr "{0}: сопряжение не удалось – снова включите режим сопряжения"

msgctxt "#30332"
msgid "Pair other controllers automatically"
msgstr "Автоматически сопрягать другие контроллеры"

msgctxt "#30333"
msgid "Xbox, PlayStation, Switch 1, 8BitDo and other gamepads in pairing mode are paired and connected automatically – no need to open the Bluetooth settings. Headphones, keyboards and other devices are never touched."
msgstr "Контроллеры Xbox, PlayStation, Switch 1, 8BitDo и другие в режиме сопряжения сопрягаются и подключаются автоматически – без настроек Bluetooth. Наушники, клавиатуры и другие устройства никогда не затрагиваются."

msgctxt "#30651"
msgid "connected"
msgstr "подключён"

msgctxt "#30652"
msgid "not connected – press a button on the controller"
msgstr "не подключён – нажмите кнопку на контроллере"

msgctxt "#30653"
msgid "Forget controller"
msgstr "Забыть контроллер"

msgctxt "#30654"
msgid "Remove the pairing of {0}? To use it again, put it into pairing mode."
msgstr "Удалить сопряжение с {0}? Чтобы снова использовать его, включите режим сопряжения."

msgctxt "#30027"
msgid "Searching for controllers for 2 minutes …"
msgstr "Поиск контроллеров в течение 2 минут …"

msgctxt "#30334"
msgid "Search for controllers continuously"
msgstr "Постоянно искать контроллеры"

msgctxt "#30335"
msgid "N-Connect keeps searching in the background, so any controller can be paired with SYNC at any time and Switch 2 controllers reconnect with a button press. When off, it only searches after \"Search for controllers now\"; paired Xbox/PlayStation controllers still reconnect on their own."
msgstr "N-Connect постоянно ищет в фоне: любой контроллер можно в любой момент подключить через SYNC, а контроллеры Switch 2 переподключаются нажатием кнопки. Выкл.: поиск только после «Искать контроллеры сейчас»; сопряжённые контроллеры Xbox/PlayStation подключаются сами."

msgctxt "#30632"
msgid "Search for controllers now"
msgstr "Искать контроллеры сейчас"

msgctxt "#30633"
msgid "Background search is off – searches for 2 minutes"
msgstr "Фоновый поиск выключен – поиск 2 минуты"

msgctxt "#30028"
msgid "{0}: battery low ({1} %) – charge soon"
msgstr "{0}: низкий заряд ({1} %) – скоро зарядите"

msgctxt "#30412"
msgid "Low battery warning"
msgstr "Предупреждение о низком заряде"

msgctxt "#30413"
msgid "Shows a message when a controller's battery drops to 20 % and again at 10 %."
msgstr "Показывает сообщение, когда заряд контроллера падает до 20 % и ещё раз до 10 %."

msgctxt "#30420"
msgid "Controller buttons in Kodi"
msgstr "Кнопки контроллера в Kodi"

msgctxt "#30421"
msgid "Capture button"
msgstr "Кнопка снимка"

msgctxt "#30422"
msgid "C button (Switch 2)"
msgstr "Кнопка C (Switch 2)"

msgctxt "#30423"
msgid "GL back button (Pro Controller 2)"
msgstr "Задняя кнопка GL (Pro Controller 2)"

msgctxt "#30424"
msgid "GR back button (Pro Controller 2)"
msgstr "Задняя кнопка GR (Pro Controller 2)"

msgctxt "#30425"
msgid "What the button does in Kodi – in addition to its normal function in games."
msgstr "Что делает кнопка в Kodi – в дополнение к обычной функции в играх."

msgctxt "#30430"
msgid "No action"
msgstr "Нет действия"

msgctxt "#30431"
msgid "Screenshot"
msgstr "Снимок экрана"

msgctxt "#30432"
msgid "Home screen"
msgstr "Главный экран"

msgctxt "#30433"
msgid "Context menu"
msgstr "Контекстное меню"

msgctxt "#30434"
msgid "Information"
msgstr "Информация"

msgctxt "#30435"
msgid "Play/pause"
msgstr "Воспроизведение/пауза"

msgctxt "#30436"
msgid "Stop"
msgstr "Стоп"

msgctxt "#30437"
msgid "Mute"
msgstr "Без звука"

msgctxt "#30438"
msgid "Power menu"
msgstr "Меню выключения"

msgctxt "#30439"
msgid "N-Connect menu"
msgstr "Меню N-Connect"

msgctxt "#30440"
msgid "Fullscreen"
msgstr "Полный экран"

msgctxt "#30140"
msgid "Emulators (motion control)"
msgstr "Эмуляторы (управление движением)"

msgctxt "#30141"
msgid "Gyro for emulators (DSU/Cemuhook)"
msgstr "Гироскоп для эмуляторов (DSU/Cemuhook)"

msgctxt "#30142"
msgid "Emulators such as Dolphin, Cemu or Citra receive motion, gyro and buttons of players 1–4 (port 26760) – for motion controls like on the console."
msgstr "Эмуляторы, например Dolphin, Cemu или Citra, получают движение, гироскоп и кнопки игроков 1–4 (порт 26760) – для управления движением, как на консоли."

msgctxt "#30143"
msgid "Also for other devices on the home network"
msgstr "Также для других устройств в домашней сети"

msgctxt "#30144"
msgid "Lets an emulator on another device (e.g. Cemu on a PC) use the motion data of controllers connected here. Only enable on a trusted home network."
msgstr "Позволяет эмулятору на другом устройстве (например, Cemu на ПК) использовать данные движения подключённых здесь контроллеров. Включайте только в доверенной домашней сети."

msgctxt "#30029"
msgid "WiFi is active and shares the antenna with Bluetooth – turn it off if unused (LibreELEC settings > Connections)"
msgstr "Wi-Fi активен и делит антенну с Bluetooth – выключите его, если он не нужен (Настройки LibreELEC > Соединения)"

msgctxt "#30655"
msgid "Connected"
msgstr "Подключён"

msgctxt "#30656"
msgid "Not connected"
msgstr "Не подключён"

msgctxt "#30660"
msgid "N-Connect app is not running"
msgstr "Приложение N-Connect не запущено"

msgctxt "#30661"
msgid "Start the N-Connect app on this PC – it reports the status here"
msgstr "Запустите приложение N-Connect на этом ПК – оно передаёт сюда состояние"
