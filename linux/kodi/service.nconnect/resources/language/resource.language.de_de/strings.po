# Kodi Media Center language file
# Addon Name: N-Connect
# Addon id: service.nconnect
# Addon Provider: devcatskz
msgid ""
msgstr ""
"Project-Id-Version: service.nconnect\n"
"Report-Msgid-Bugs-To: https://github.com/DevCatSKZ/N-Connect/issues\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: de_DE\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# ---------- Meldungen ----------

msgctxt "#30010"
msgid "Player {0}: {1} connected"
msgstr "Spieler {0}: {1} verbunden"

msgctxt "#30011"
msgid "Joy-Con pair ready (player {0})"
msgstr "Joy-Con-Paar bereit (Spieler {0})"

msgctxt "#30012"
msgid "Player {0}: {1} disconnected"
msgstr "Spieler {0}: {1} getrennt"

msgctxt "#30013"
msgid "{0} is paired with another device – press SYNC to use it here"
msgstr "{0} ist mit einem anderen Gerät gekoppelt – SYNC drücken, um ihn hier zu nutzen"

msgctxt "#30014"
msgid "{0}: connection failed – press SYNC and try again"
msgstr "{0}: Verbindung fehlgeschlagen – SYNC drücken und erneut versuchen"

msgctxt "#30015"
msgid "Bluetooth is off – enable it in the LibreELEC settings"
msgstr "Bluetooth ist aus – in den LibreELEC-Einstellungen einschalten"

msgctxt "#30016"
msgid "No Bluetooth adapter found"
msgstr "Kein Bluetooth-Adapter gefunden"

msgctxt "#30017"
msgid "Virtual controller could not be created – run the diagnostics"
msgstr "Virtueller Controller konnte nicht angelegt werden – Diagnose ausführen"

msgctxt "#30018"
msgid "N-Connect keeps stopping – see the log in the add-on settings"
msgstr "N-Connect beendet sich immer wieder – Protokoll in den Add-on-Einstellungen ansehen"

msgctxt "#30022"
msgid "This processor is not supported ({0})"
msgstr "Dieser Prozessor wird nicht unterstützt ({0})"

# ---------- Einstellungen ----------

msgctxt "#30100"
msgid "Controller"
msgstr "Controller"

msgctxt "#30101"
msgid "Buttons and sticks"
msgstr "Tasten und Sticks"

msgctxt "#30102"
msgid "Joy-Con"
msgstr "Joy-Con"

msgctxt "#30103"
msgid "Gyro aiming"
msgstr "Gyro-Zielen"

msgctxt "#30110"
msgid "Button layout"
msgstr "Tastenbelegung"

msgctxt "#30111"
msgid "How the Nintendo face buttons are passed on as Xbox buttons. By position: the bottom button acts as A, like on an Xbox controller – recommended for Kodi and most games. As labelled: A stays A (right), B stays B (bottom), like on the Switch."
msgstr "Wie die Nintendo-Tasten als Xbox-Tasten weitergegeben werden. Nach Position: Die untere Taste wirkt als A wie beim Xbox-Controller – empfohlen für Kodi und die meisten Spiele. Wie beschriftet: A bleibt A (rechts), B bleibt B (unten) wie auf der Switch."

msgctxt "#30112"
msgid "By position (Xbox)"
msgstr "Nach Position (Xbox)"

msgctxt "#30113"
msgid "As labelled (Nintendo)"
msgstr "Wie beschriftet (Nintendo)"

msgctxt "#30114"
msgid "Stick dead zone"
msgstr "Stick-Totzone"

msgctxt "#30115"
msgid "Small stick movements inside this range are ignored. Increase it if the menu drifts on its own."
msgstr "Kleine Stickbewegungen in diesem Bereich werden ignoriert. Erhöhen, wenn das Menü von selbst wandert."

msgctxt "#30120"
msgid "Combine two Joy-Con into one controller"
msgstr "Zwei Joy-Con zu einem Controller zusammenfassen"

msgctxt "#30121"
msgid "A left and a right Joy-Con act as one full controller. Turn off to use each Joy-Con on its own (held sideways) for two players."
msgstr "Ein linker und ein rechter Joy-Con ergeben einen vollständigen Controller. Ausschalten, um jeden Joy-Con einzeln (quer gehalten) für zwei Spieler zu nutzen."

msgctxt "#30130"
msgid "Gyro moves the right stick"
msgstr "Gyro steuert den rechten Stick"

msgctxt "#30131"
msgid "Tilting the controller moves the right stick – for precise aiming in games. While aiming: only while ZL is held."
msgstr "Kippen des Controllers bewegt den rechten Stick – für genaues Zielen in Spielen. Beim Zielen: nur solange ZL gedrückt ist."

msgctxt "#30132"
msgid "Off"
msgstr "Aus"

msgctxt "#30133"
msgid "Always"
msgstr "Immer"

msgctxt "#30134"
msgid "While aiming (ZL held)"
msgstr "Beim Zielen (ZL gedrückt)"

msgctxt "#30135"
msgid "Gyro speed for full stick (°/s)"
msgstr "Gyro-Tempo für vollen Ausschlag (°/s)"

msgctxt "#30136"
msgid "Turning speed that moves the stick all the way. Lower values make the gyro more sensitive."
msgstr "Drehgeschwindigkeit, bei der der Stick ganz ausschlägt. Kleinere Werte machen den Gyro empfindlicher."

msgctxt "#30137"
msgid "Invert gyro up/down"
msgstr "Gyro oben/unten umkehren"

msgctxt "#30138"
msgid "Tilting forward looks up instead of down."
msgstr "Nach vorn kippen schaut nach oben statt nach unten."

msgctxt "#30200"
msgid "Rumble"
msgstr "Vibration"

msgctxt "#30201"
msgid "Rumble"
msgstr "Vibration"

msgctxt "#30210"
msgid "Rumble"
msgstr "Vibration"

msgctxt "#30211"
msgid "Games can make the controller vibrate."
msgstr "Spiele können den Controller vibrieren lassen."

msgctxt "#30212"
msgid "Strength"
msgstr "Stärke"

msgctxt "#30213"
msgid "How strongly the controller vibrates."
msgstr "Wie stark der Controller vibriert."

msgctxt "#30300"
msgid "Connection"
msgstr "Verbindung"

msgctxt "#30301"
msgid "Pairing"
msgstr "Koppeln"

msgctxt "#30302"
msgid "Battery saving"
msgstr "Akku sparen"

msgctxt "#30303"
msgid "Advanced"
msgstr "Erweitert"

msgctxt "#30310"
msgid "Remember controllers (pair in SYNC mode)"
msgstr "Controller merken (im SYNC-Modus koppeln)"

msgctxt "#30311"
msgid "When you press SYNC, the controller is paired with this device. After that, any button reconnects it. A controller remembers only one device – to use it on the Switch 2 or a PC again, press SYNC there."
msgstr "Nach dem Drücken von SYNC wird der Controller mit diesem Gerät gekoppelt. Danach verbindet ihn jede beliebige Taste wieder. Ein Controller merkt sich nur ein Gerät – um ihn wieder an der Switch 2 oder am PC zu nutzen, dort SYNC drücken."

msgctxt "#30312"
msgid "Show player number on the LEDs"
msgstr "Spielernummer an den LEDs anzeigen"

msgctxt "#30313"
msgid "The controller lights show which player it is."
msgstr "Die Lämpchen am Controller zeigen, welcher Spieler er ist."

msgctxt "#30314"
msgid "Short vibration when connected"
msgstr "Kurze Vibration beim Verbinden"

msgctxt "#30315"
msgid "The controller clicks briefly once it is ready."
msgstr "Der Controller klickt kurz, sobald er bereit ist."

msgctxt "#30316"
msgid "Disconnect when unused"
msgstr "Bei Nichtbenutzung trennen"

msgctxt "#30317"
msgid "Disconnects a controller after this time without input to save its battery. Press any button to reconnect."
msgstr "Trennt einen Controller nach dieser Zeit ohne Eingabe, um seinen Akku zu schonen. Eine beliebige Taste verbindet ihn wieder."

msgctxt "#30320"
msgid "Never"
msgstr "Nie"

msgctxt "#30321"
msgid "After 5 minutes"
msgstr "Nach 5 Minuten"

msgctxt "#30322"
msgid "After 10 minutes"
msgstr "Nach 10 Minuten"

msgctxt "#30323"
msgid "After 15 minutes"
msgstr "Nach 15 Minuten"

msgctxt "#30324"
msgid "After 30 minutes"
msgstr "Nach 30 Minuten"

msgctxt "#30325"
msgid "After 60 minutes"
msgstr "Nach 60 Minuten"

msgctxt "#30330"
msgid "Bluetooth adapter"
msgstr "Bluetooth-Adapter"

msgctxt "#30331"
msgid "Leave empty to use the first adapter. Only needed with more than one adapter, e.g. hci1 for a USB stick."
msgstr "Leer lassen, um den ersten Adapter zu nutzen. Nur bei mehreren Adaptern nötig, z. B. hci1 für einen USB-Stick."

msgctxt "#30400"
msgid "Kodi"
msgstr "Kodi"

msgctxt "#30401"
msgid "Notifications"
msgstr "Meldungen"

msgctxt "#30410"
msgid "Show notifications"
msgstr "Meldungen anzeigen"

msgctxt "#30411"
msgid "Shows a short message when a controller connects or disconnects. Errors are always shown."
msgstr "Zeigt eine kurze Meldung, wenn ein Controller verbunden oder getrennt wird. Fehler werden immer angezeigt."

msgctxt "#30500"
msgid "Help"
msgstr "Hilfe"

msgctxt "#30501"
msgid "N-Connect"
msgstr "N-Connect"

msgctxt "#30510"
msgid "Controllers and status"
msgstr "Controller und Status"

msgctxt "#30511"
msgid "Shows connected controllers with battery level and lets you disconnect them."
msgstr "Zeigt die verbundenen Controller mit Akkustand und erlaubt das Trennen."

msgctxt "#30512"
msgid "How to connect a controller"
msgstr "So verbindest du einen Controller"

msgctxt "#30513"
msgid "Step-by-step guide for the first connection and for reconnecting."
msgstr "Schritt-für-Schritt-Anleitung für das erste Verbinden und das Wiederverbinden."

msgctxt "#30514"
msgid "Run diagnostics"
msgstr "Diagnose ausführen"

msgctxt "#30515"
msgid "Checks Bluetooth and the virtual controller and shows what is missing."
msgstr "Prüft Bluetooth und den virtuellen Controller und zeigt, was fehlt."

msgctxt "#30516"
msgid "Show log"
msgstr "Protokoll anzeigen"

msgctxt "#30517"
msgid "The latest N-Connect log entries – useful when reporting a problem."
msgstr "Die letzten Einträge des N-Connect-Protokolls – hilfreich, wenn du ein Problem meldest."

# ---------- Menü ----------

msgctxt "#30600"
msgid "Player {0}: {1}"
msgstr "Spieler {0}: {1}"

msgctxt "#30601"
msgid "Battery {0} %"
msgstr "Akku {0} %"

msgctxt "#30602"
msgid "charging"
msgstr "lädt"

msgctxt "#30603"
msgid "{0} updates/s"
msgstr "{0} Updates/s"

msgctxt "#30604"
msgid "No controller connected"
msgstr "Kein Controller verbunden"

msgctxt "#30605"
msgid "Press SYNC (Switch 2) or the pairing button (other controllers). Already paired: press any button."
msgstr "SYNC (Switch 2) bzw. Kopplungstaste (andere Controller) drücken. Schon gekoppelt: eine Taste drücken."

msgctxt "#30606"
msgid "{0} found"
msgstr "{0} gefunden"

msgctxt "#30607"
msgid "Paired with another device – press SYNC to use it here"
msgstr "Mit einem anderen Gerät gekoppelt – SYNC drücken, um ihn hier zu nutzen"

msgctxt "#30608"
msgid "Bluetooth is off"
msgstr "Bluetooth ist aus"

msgctxt "#30609"
msgid "Open LibreELEC settings > Bluetooth and enable it"
msgstr "LibreELEC-Einstellungen > Bluetooth öffnen und einschalten"

msgctxt "#30610"
msgid "No Bluetooth adapter"
msgstr "Kein Bluetooth-Adapter"

msgctxt "#30611"
msgid "Plug in a Bluetooth adapter or enable the built-in one in the LibreELEC settings"
msgstr "Bluetooth-Adapter einstecken oder den eingebauten in den LibreELEC-Einstellungen aktivieren"

msgctxt "#30612"
msgid "N-Connect is not running"
msgstr "N-Connect läuft nicht"

msgctxt "#30613"
msgid "Select to restart. If it keeps stopping, run the diagnostics."
msgstr "Auswählen zum Neustarten. Beendet es sich immer wieder, die Diagnose ausführen."

msgctxt "#30614"
msgid "Disconnect all controllers"
msgstr "Alle Controller trennen"

msgctxt "#30615"
msgid "How to connect a controller"
msgstr "So verbindest du einen Controller"

msgctxt "#30616"
msgid "Run diagnostics"
msgstr "Diagnose ausführen"

msgctxt "#30617"
msgid "Show log"
msgstr "Protokoll anzeigen"

msgctxt "#30618"
msgid "Settings"
msgstr "Einstellungen"

msgctxt "#30619"
msgid "Disconnect"
msgstr "Trennen"

msgctxt "#30620"
msgid "Details"
msgstr "Details"

msgctxt "#30621"
msgid "Connecting …"
msgstr "Verbinde …"

msgctxt "#30622"
msgid "N-Connect diagnostics"
msgstr "N-Connect-Diagnose"

msgctxt "#30623"
msgid "[B]Everything is ready.[/B] Press SYNC on a controller to connect it."
msgstr "[B]Alles bereit.[/B] Drücke SYNC an einem Controller, um ihn zu verbinden."

msgctxt "#30624"
msgid "[B]Something is missing[/B] – see the red entries below."
msgstr "[B]Etwas fehlt[/B] – siehe die roten Einträge unten."

msgctxt "#30625"
msgid "The log is empty."
msgstr "Das Protokoll ist leer."

msgctxt "#30626"
msgid "Serial number"
msgstr "Seriennummer"

msgctxt "#30627"
msgid "Firmware"
msgstr "Firmware"

msgctxt "#30628"
msgid "Address"
msgstr "Adresse"

msgctxt "#30629"
msgid "N-Connect log"
msgstr "N-Connect-Protokoll"

msgctxt "#30630"
msgid "Waiting for Bluetooth …"
msgstr "Warte auf Bluetooth …"

msgctxt "#30631"
msgid "N-Connect is starting …"
msgstr "N-Connect startet …"

msgctxt "#30640"
msgid "Virtual controller"
msgstr "Virtueller Controller"

msgctxt "#30641"
msgid "Bluetooth service"
msgstr "Bluetooth-Dienst"

msgctxt "#30642"
msgid "Bluetooth adapter"
msgstr "Bluetooth-Adapter"

msgctxt "#30643"
msgid "Low latency"
msgstr "Geringe Verzögerung"

msgctxt "#30644"
msgid "Settings file"
msgstr "Einstellungsdatei"

msgctxt "#30645"
msgid "Checking Bluetooth and the virtual controller …"
msgstr "Prüfe Bluetooth und den virtuellen Controller …"

# ---------- Andere Controller ----------

msgctxt "#30023"
msgid "{0} paired – from now on a button press reconnects it"
msgstr "{0} gekoppelt – ab jetzt genügt ein Tastendruck"

msgctxt "#30024"
msgid "{0} connected"
msgstr "{0} verbunden"

msgctxt "#30025"
msgid "{0} disconnected"
msgstr "{0} getrennt"

msgctxt "#30026"
msgid "{0}: pairing failed – put it into pairing mode again"
msgstr "{0}: Kopplung fehlgeschlagen – erneut in den Kopplungsmodus bringen"

msgctxt "#30332"
msgid "Pair other controllers automatically"
msgstr "Andere Controller automatisch koppeln"

msgctxt "#30333"
msgid "Xbox, PlayStation, Switch 1, 8BitDo and other gamepads in pairing mode are paired and connected automatically – no need to open the Bluetooth settings. Headphones, keyboards and other devices are never touched."
msgstr "Xbox-, PlayStation-, Switch-1-, 8BitDo- und andere Gamepads im Kopplungsmodus werden automatisch gekoppelt und verbunden – ohne Umweg über die Bluetooth-Einstellungen. Kopfhörer, Tastaturen und andere Geräte werden nie angefasst."

msgctxt "#30651"
msgid "connected"
msgstr "verbunden"

msgctxt "#30652"
msgid "not connected – press a button on the controller"
msgstr "nicht verbunden – eine Taste am Controller drücken"

msgctxt "#30653"
msgid "Forget controller"
msgstr "Controller vergessen"

msgctxt "#30654"
msgid "Remove the pairing of {0}? To use it again, put it into pairing mode."
msgstr "Kopplung von {0} löschen? Zum erneuten Verwenden in den Kopplungsmodus bringen."

msgctxt "#30027"
msgid "Searching for controllers for 2 minutes …"
msgstr "Suche 2 Minuten nach Controllern …"

msgctxt "#30334"
msgid "Search for controllers continuously"
msgstr "Ständig nach Controllern suchen"

msgctxt "#30335"
msgid "N-Connect keeps searching in the background, so any controller can be paired with SYNC at any time and Switch 2 controllers reconnect with a button press. When off, it only searches after \"Search for controllers now\"; paired Xbox/PlayStation controllers still reconnect on their own."
msgstr "N-Connect sucht ständig im Hintergrund – so lässt sich jederzeit jeder Controller per SYNC koppeln, und Switch-2-Controller verbinden sich per Tastendruck neu. Aus: Gesucht wird nur nach „Jetzt nach Controllern suchen“; gekoppelte Xbox-/PlayStation-Controller verbinden sich trotzdem selbst."

msgctxt "#30632"
msgid "Search for controllers now"
msgstr "Jetzt nach Controllern suchen"

msgctxt "#30633"
msgid "Background search is off – searches for 2 minutes"
msgstr "Hintergrundsuche ist aus – sucht 2 Minuten lang"

msgctxt "#30028"
msgid "{0}: battery low ({1} %) – charge soon"
msgstr "{0}: Akku schwach ({1} %) – bald aufladen"

msgctxt "#30412"
msgid "Low battery warning"
msgstr "Warnung bei schwachem Akku"

msgctxt "#30413"
msgid "Shows a message when a controller's battery drops to 20 % and again at 10 %."
msgstr "Zeigt eine Meldung, wenn der Akku eines Controllers auf 20 % und noch einmal auf 10 % fällt."

msgctxt "#30420"
msgid "Controller buttons in Kodi"
msgstr "Controller-Tasten in Kodi"

msgctxt "#30421"
msgid "Capture button"
msgstr "Aufnahmetaste (Capture)"

msgctxt "#30422"
msgid "C button (Switch 2)"
msgstr "C-Taste (Switch 2)"

msgctxt "#30423"
msgid "GL back button (Pro Controller 2)"
msgstr "GL-Rückseitentaste (Pro Controller 2)"

msgctxt "#30424"
msgid "GR back button (Pro Controller 2)"
msgstr "GR-Rückseitentaste (Pro Controller 2)"

msgctxt "#30425"
msgid "What the button does in Kodi – in addition to its normal function in games."
msgstr "Was die Taste in Kodi auslöst – zusätzlich zu ihrer normalen Funktion in Spielen."

msgctxt "#30430"
msgid "No action"
msgstr "Keine Aktion"

msgctxt "#30431"
msgid "Screenshot"
msgstr "Bildschirmfoto"

msgctxt "#30432"
msgid "Home screen"
msgstr "Startseite"

msgctxt "#30433"
msgid "Context menu"
msgstr "Kontextmenü"

msgctxt "#30434"
msgid "Information"
msgstr "Informationen"

msgctxt "#30435"
msgid "Play/pause"
msgstr "Wiedergabe/Pause"

msgctxt "#30436"
msgid "Stop"
msgstr "Stopp"

msgctxt "#30437"
msgid "Mute"
msgstr "Stumm"

msgctxt "#30438"
msgid "Power menu"
msgstr "Ausschaltmenü"

msgctxt "#30439"
msgid "N-Connect menu"
msgstr "N-Connect-Menü"

msgctxt "#30440"
msgid "Fullscreen"
msgstr "Vollbild"

msgctxt "#30140"
msgid "Emulators (motion control)"
msgstr "Emulatoren (Bewegungssteuerung)"

msgctxt "#30141"
msgid "Gyro for emulators (DSU/Cemuhook)"
msgstr "Gyro für Emulatoren (DSU/Cemuhook)"

msgctxt "#30142"
msgid "Emulators such as Dolphin, Cemu or Citra receive motion, gyro and buttons of players 1–4 (port 26760) – for motion controls like on the console."
msgstr "Emulatoren wie Dolphin, Cemu oder Citra erhalten Bewegung, Gyro und Tasten der Spieler 1–4 (Port 26760) – für Bewegungssteuerung wie an der Konsole."

msgctxt "#30143"
msgid "Also for other devices on the home network"
msgstr "Auch für andere Geräte im Heimnetz"

msgctxt "#30144"
msgid "Lets an emulator on another device (e.g. Cemu on a PC) use the motion data of controllers connected here. Only enable on a trusted home network."
msgstr "Erlaubt einem Emulator auf einem anderen Gerät (z. B. Cemu auf dem PC), die Bewegungsdaten der hier verbundenen Controller zu nutzen. Nur im vertrauenswürdigen Heimnetz einschalten."

msgctxt "#30029"
msgid "WiFi is active and shares the antenna with Bluetooth – turn it off if unused (LibreELEC settings > Connections)"
msgstr "WLAN ist aktiv und teilt sich die Antenne mit Bluetooth – ausschalten, wenn es nicht gebraucht wird (LibreELEC-Einstellungen > Verbindungen)"

msgctxt "#30655"
msgid "Connected"
msgstr "Verbunden"

msgctxt "#30656"
msgid "Not connected"
msgstr "Nicht verbunden"

msgctxt "#30660"
msgid "N-Connect app is not running"
msgstr "N-Connect-App läuft nicht"

msgctxt "#30661"
msgid "Start the N-Connect app on this device – it reports the status here"
msgstr "Die App N-Connect auf diesem Gerät starten – sie meldet den Status hierher"
