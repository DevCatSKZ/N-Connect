msgstr "Activez le Bluetooth dans les paramètres Windows"

msgctxt "#30663"
msgid "Turn on Bluetooth in Android"
msgstr "Activez le Bluetooth dans Android"

msgctxt "#30664"
msgid "Plug in a Bluetooth adapter or turn on Bluetooth in the Windows settings"
msgstr "Branchez un adaptateur Bluetooth ou activez le Bluetooth dans les paramètres Windows"

