msgctxt "#30010"
msgid "Player {0}: {1} connected"
msgstr "Joueur {0} : {1} connectée"

msgctxt "#30011"
msgid "Joy-Con pair ready (player {0})"
msgstr "Paire de Joy-Con prête (joueur {0})"

msgctxt "#30012"
msgid "Player {0}: {1} disconnected"
msgstr "Joueur {0} : {1} déconnectée"

msgctxt "#30013"
msgid "{0} is paired with another device – press SYNC to use it here"
msgstr "{0} est associée à un autre appareil – appuyez sur SYNC pour l'utiliser ici"

msgctxt "#30014"
msgid "{0}: connection failed – press SYNC and try again"
msgstr "{0} : échec de la connexion – appuyez sur SYNC et réessayez"

msgctxt "#30015"
msgid "Bluetooth is off – enable it in the LibreELEC settings"
msgstr "Le Bluetooth est désactivé – activez-le dans les paramètres LibreELEC"

msgctxt "#30016"
msgid "No Bluetooth adapter found"
msgstr "Aucun adaptateur Bluetooth trouvé"

msgctxt "#30017"
msgid "Virtual controller could not be created – run the diagnostics"
msgstr "Impossible de créer la manette virtuelle – lancez le diagnostic"

msgctxt "#30018"
msgid "SKZ Connect keeps stopping – see the log in the add-on settings"
msgstr "SKZ Connect s'arrête sans cesse – consultez le journal dans les paramètres de l'extension"

msgctxt "#30022"
msgid "This processor is not supported ({0})"
msgstr "Ce processeur n'est pas pris en charge ({0})"

msgctxt "#30100"
msgid "Controller"
msgstr "Manette"

msgctxt "#30101"
msgid "Buttons and sticks"
msgstr "Boutons et sticks"

msgctxt "#30102"
msgid "Joy-Con"
msgstr "Joy-Con"

msgctxt "#30103"
msgid "Gyro aiming"
msgstr "Visée gyroscopique"

msgctxt "#30110"
msgid "Button layout"
msgstr "Disposition des boutons"

msgctxt "#30111"
msgid "How the Nintendo face buttons are passed on as Xbox buttons. By position: the bottom button acts as A, like on an Xbox controller – recommended for Kodi and most games. As labelled: A stays A (right), B stays B (bottom), like on the Switch."
msgstr "Comment les boutons Nintendo sont transmis comme boutons Xbox. Par position : le bouton du bas agit comme A, comme sur une manette Xbox – recommandé pour Kodi et la plupart des jeux. Selon l'inscription : A reste A (droite), B reste B (bas), comme sur la Switch."

msgctxt "#30112"
msgid "By position (Xbox)"
msgstr "Par position (Xbox)"

msgctxt "#30113"
msgid "As labelled (Nintendo)"
msgstr "Selon l'inscription (Nintendo)"

msgctxt "#30114"
msgid "Stick dead zone"
msgstr "Zone morte du stick"

msgctxt "#30115"
msgid "Small stick movements inside this range are ignored. Increase it if the menu drifts on its own."
msgstr "Les petits mouvements du stick dans cette zone sont ignorés. Augmentez-la si le menu défile tout seul."

msgctxt "#30120"
msgid "Combine two Joy-Con into one controller"
msgstr "Combiner deux Joy-Con en une manette"

msgctxt "#30121"
msgid "A left and a right Joy-Con act as one full controller. Turn off to use each Joy-Con on its own (held sideways) for two players."
msgstr "Un Joy-Con gauche et un droit forment une manette complète. Désactivez pour utiliser chaque Joy-Con seul (à l'horizontale) pour deux joueurs."

msgctxt "#30130"
msgid "Gyro moves the right stick"
msgstr "Le gyroscope déplace le stick droit"

msgctxt "#30131"
msgid "Tilting the controller moves the right stick – for precise aiming in games. While aiming: only while ZL is held."
msgstr "Incliner la manette déplace le stick droit – pour viser précisément. En visant : uniquement tant que ZL est maintenu."

msgctxt "#30132"
msgid "Off"
msgstr "Désactivé"

msgctxt "#30133"
msgid "Always"
msgstr "Toujours"

msgctxt "#30134"
msgid "While aiming (ZL held)"
msgstr "En visant (ZL maintenu)"

msgctxt "#30135"
msgid "Gyro speed for full stick (°/s)"
msgstr "Vitesse gyroscopique pour le stick complet (°/s)"

msgctxt "#30136"
msgid "Turning speed that moves the stick all the way. Lower values make the gyro more sensitive."
msgstr "Vitesse de rotation qui déplace le stick à fond. Des valeurs plus faibles rendent le gyroscope plus sensible."

msgctxt "#30137"
msgid "Invert gyro up/down"
msgstr "Inverser le gyroscope haut/bas"

msgctxt "#30138"
msgid "Tilting forward looks up instead of down."
msgstr "Incliner vers l'avant regarde vers le haut au lieu du bas."

msgctxt "#30200"
msgid "Rumble"
msgstr "Vibration"

msgctxt "#30201"
msgid "Rumble"
msgstr "Vibration"

msgctxt "#30210"
msgid "Rumble"
msgstr "Vibration"

msgctxt "#30211"
msgid "Games can make the controller vibrate."
msgstr "Les jeux peuvent faire vibrer la manette."

msgctxt "#30212"
msgid "Strength"
msgstr "Intensité"

msgctxt "#30213"
msgid "How strongly the controller vibrates."
msgstr "Force de la vibration de la manette."

msgctxt "#30300"
msgid "Connection"
msgstr "Connexion"

msgctxt "#30301"
msgid "Pairing"
msgstr "Association"

msgctxt "#30302"
msgid "Battery saving"
msgstr "Économie de batterie"

msgctxt "#30303"
msgid "Advanced"
msgstr "Avancé"

msgctxt "#30310"
msgid "Remember controllers (pair in SYNC mode)"
msgstr "Mémoriser les manettes (association en mode SYNC)"

msgctxt "#30311"
msgid "When you press SYNC, the controller is paired with this device. After that, any button reconnects it. A controller remembers only one device – to use it on the Switch 2 or a PC again, press SYNC there."
msgstr "En appuyant sur SYNC, la manette est associée à cet appareil. Ensuite, n'importe quel bouton la reconnecte. Une manette ne mémorise qu'un seul appareil – pour la réutiliser sur la Switch 2 ou un PC, appuyez sur SYNC là-bas."

msgctxt "#30312"
msgid "Show player number on the LEDs"
msgstr "Afficher le numéro de joueur sur les LED"

msgctxt "#30313"
msgid "The controller lights show which player it is."
msgstr "Les voyants de la manette indiquent le joueur."

msgctxt "#30314"
msgid "Short vibration when connected"
msgstr "Courte vibration à la connexion"

msgctxt "#30315"
msgid "The controller clicks briefly once it is ready."
msgstr "La manette émet un bref clic dès qu'elle est prête."

msgctxt "#30316"
msgid "Disconnect when unused"
msgstr "Déconnecter si inutilisée"

msgctxt "#30317"
msgid "Disconnects a controller after this time without input to save its battery. Press any button to reconnect."
msgstr "Déconnecte une manette après ce délai sans utilisation pour préserver sa batterie. Appuyez sur un bouton pour la reconnecter."

msgctxt "#30320"
msgid "Never"
msgstr "Jamais"

msgctxt "#30321"
msgid "After 5 minutes"
msgstr "Après 5 minutes"

msgctxt "#30322"
msgid "After 10 minutes"
msgstr "Après 10 minutes"

msgctxt "#30323"
msgid "After 15 minutes"
msgstr "Après 15 minutes"

msgctxt "#30324"
msgid "After 30 minutes"
msgstr "Après 30 minutes"

msgctxt "#30325"
msgid "After 60 minutes"
msgstr "Après 60 minutes"

msgctxt "#30330"
msgid "Bluetooth adapter"
msgstr "Adaptateur Bluetooth"

msgctxt "#30331"
msgid "Leave empty to use the first adapter. Only needed with more than one adapter, e.g. hci1 for a USB stick."
msgstr "Laissez vide pour utiliser le premier adaptateur. Nécessaire uniquement avec plusieurs adaptateurs, p. ex. hci1 pour une clé USB."

msgctxt "#30400"
msgid "Kodi"
msgstr "Kodi"

msgctxt "#30401"
msgid "Notifications"
msgstr "Notifications"

msgctxt "#30410"
msgid "Show notifications"
msgstr "Afficher les notifications"

msgctxt "#30411"
msgid "Shows a short message when a controller connects or disconnects. Errors are always shown."
msgstr "Affiche un court message lorsqu'une manette se connecte ou se déconnecte. Les erreurs sont toujours affichées."

