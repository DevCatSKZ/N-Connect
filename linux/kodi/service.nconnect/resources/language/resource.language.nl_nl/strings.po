msgid "Controllers and status"
msgstr "Controllers en status"

msgctxt "#30511"
msgid "Shows connected controllers with battery level and lets you disconnect them."
msgstr "Toont de verbonden controllers met batterijniveau en laat je ze loskoppelen."

msgctxt "#30512"
msgid "How to connect a controller"
msgstr "Zo verbind je een controller"

msgctxt "#30513"
msgid "Step-by-step guide for the first connection and for reconnecting."
msgstr "Stap-voor-stap-handleiding voor de eerste verbinding en opnieuw verbinden."

msgctxt "#30514"
msgid "Run diagnostics"
msgstr "Diagnose uitvoeren"

msgctxt "#30515"
msgid "Checks Bluetooth and the virtual controller and shows what is missing."
msgstr "Controleert Bluetooth en de virtuele controller en laat zien wat ontbreekt."

msgctxt "#30516"
msgid "Show log"
msgstr "Logboek tonen"

msgctxt "#30517"
msgid "The latest N-Connect log entries – useful when reporting a problem."
msgstr "De laatste regels van het N-Connect-logboek – handig bij het melden van een probleem."

