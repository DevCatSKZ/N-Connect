msgctxt "#30010"
msgid "Player {0}: {1} connected"
msgstr "Speler {0}: {1} verbonden"

msgctxt "#30011"
msgid "Joy-Con pair ready (player {0})"
msgstr "Joy-Con-paar klaar (speler {0})"

msgctxt "#30012"
msgid "Player {0}: {1} disconnected"
msgstr "Speler {0}: {1} losgekoppeld"

msgctxt "#30013"
msgid "{0} is paired with another device – press SYNC to use it here"
msgstr "{0} is gekoppeld aan een ander apparaat – druk op SYNC om hem hier te gebruiken"

msgctxt "#30014"
msgid "{0}: connection failed – press SYNC and try again"
msgstr "{0}: verbinding mislukt – druk op SYNC en probeer opnieuw"

msgctxt "#30015"
msgid "Bluetooth is off – enable it in the LibreELEC settings"
msgstr "Bluetooth staat uit – zet het aan in de LibreELEC-instellingen"

msgctxt "#30016"
msgid "No Bluetooth adapter found"
msgstr "Geen Bluetooth-adapter gevonden"

msgctxt "#30017"
msgid "Virtual controller could not be created – run the diagnostics"
msgstr "Virtuele controller kon niet worden aangemaakt – voer de diagnose uit"

msgctxt "#30018"
msgid "N-Connect keeps stopping – see the log in the add-on settings"
msgstr "N-Connect stopt steeds – bekijk het logboek in de add-on-instellingen"

msgctxt "#30022"
msgid "This processor is not supported ({0})"
msgstr "Deze processor wordt niet ondersteund ({0})"

msgctxt "#30100"
msgid "Controller"
msgstr "Controller"

msgctxt "#30101"
msgid "Buttons and sticks"
msgstr "Knoppen en sticks"

msgctxt "#30102"
msgid "Joy-Con"
msgstr "Joy-Con"

msgctxt "#30103"
msgid "Gyro aiming"
msgstr "Richten met gyroscoop"

msgctxt "#30110"
msgid "Button layout"
msgstr "Knopindeling"

msgctxt "#30111"
msgid "How the Nintendo face buttons are passed on as Xbox buttons. By position: the bottom button acts as A, like on an Xbox controller – recommended for Kodi and most games. As labelled: A stays A (right), B stays B (bottom), like on the Switch."
msgstr "Hoe de Nintendo-knoppen als Xbox-knoppen worden doorgegeven. Volgens positie: de onderste knop werkt als A, zoals op een Xbox-controller – aanbevolen voor Kodi en de meeste games. Volgens opschrift: A blijft A (rechts), B blijft B (onder), zoals op de Switch."

msgctxt "#30112"
msgid "By position (Xbox)"
msgstr "Volgens positie (Xbox)"

msgctxt "#30113"
msgid "As labelled (Nintendo)"
msgstr "Volgens opschrift (Nintendo)"

msgctxt "#30114"
msgid "Stick dead zone"
msgstr "Dode zone van de stick"

msgctxt "#30115"
msgid "Small stick movements inside this range are ignored. Increase it if the menu drifts on its own."
msgstr "Kleine stickbewegingen binnen dit bereik worden genegeerd. Verhoog dit als het menu vanzelf verschuift."

msgctxt "#30120"
msgid "Combine two Joy-Con into one controller"
msgstr "Twee Joy-Con combineren tot één controller"

msgctxt "#30121"
msgid "A left and a right Joy-Con act as one full controller. Turn off to use each Joy-Con on its own (held sideways) for two players."
msgstr "Een linker en een rechter Joy-Con vormen samen een volledige controller. Uitzetten om elke Joy-Con apart (horizontaal) te gebruiken voor twee spelers."

msgctxt "#30130"
msgid "Gyro moves the right stick"
msgstr "Gyroscoop bestuurt de rechterstick"

msgctxt "#30131"
msgid "Tilting the controller moves the right stick – for precise aiming in games. While aiming: only while ZL is held."
msgstr "Kantelen van de controller beweegt de rechterstick – voor nauwkeurig richten. Bij richten: alleen zolang ZL ingedrukt is."

msgctxt "#30132"
msgid "Off"
msgstr "Uit"

msgctxt "#30133"
msgid "Always"
msgstr "Altijd"

msgctxt "#30134"
msgid "While aiming (ZL held)"
msgstr "Bij richten (ZL ingedrukt)"

msgctxt "#30135"
msgid "Gyro speed for full stick (°/s)"
msgstr "Gyrosnelheid voor volle uitslag (°/s)"

msgctxt "#30136"
msgid "Turning speed that moves the stick all the way. Lower values make the gyro more sensitive."
msgstr "Draaisnelheid waarbij de stick volledig uitslaat. Lagere waarden maken de gyroscoop gevoeliger."

msgctxt "#30137"
msgid "Invert gyro up/down"
msgstr "Gyroscoop omhoog/omlaag omkeren"

msgctxt "#30138"
msgid "Tilting forward looks up instead of down."
msgstr "Naar voren kantelen kijkt omhoog in plaats van omlaag."

msgctxt "#30200"
msgid "Rumble"
msgstr "Trillen"

msgctxt "#30201"
msgid "Rumble"
msgstr "Trillen"

msgctxt "#30210"
msgid "Rumble"
msgstr "Trillen"

msgctxt "#30211"
msgid "Games can make the controller vibrate."
msgstr "Games kunnen de controller laten trillen."

msgctxt "#30212"
msgid "Strength"
msgstr "Sterkte"

msgctxt "#30213"
msgid "How strongly the controller vibrates."
msgstr "Hoe sterk de controller trilt."

msgctxt "#30300"
msgid "Connection"
msgstr "Verbinding"

msgctxt "#30301"
msgid "Pairing"
msgstr "Koppelen"

msgctxt "#30302"
msgid "Battery saving"
msgstr "Batterij sparen"

msgctxt "#30303"
msgid "Advanced"
msgstr "Geavanceerd"

msgctxt "#30310"
msgid "Remember controllers (pair in SYNC mode)"
msgstr "Controllers onthouden (koppelen in SYNC-modus)"

msgctxt "#30311"
msgid "When you press SYNC, the controller is paired with this device. After that, any button reconnects it. A controller remembers only one device – to use it on the Switch 2 or a PC again, press SYNC there."
msgstr "Na het indrukken van SYNC wordt de controller aan dit apparaat gekoppeld. Daarna verbindt elke knop hem opnieuw. Een controller onthoudt maar één apparaat – om hem weer op de Switch 2 of een pc te gebruiken, druk je daar op SYNC."

msgctxt "#30312"
msgid "Show player number on the LEDs"
msgstr "Spelernummer op de leds tonen"

msgctxt "#30313"
msgid "The controller lights show which player it is."
msgstr "De lampjes van de controller tonen welke speler het is."

msgctxt "#30314"
msgid "Short vibration when connected"
msgstr "Korte trilling bij verbinden"

msgctxt "#30315"
msgid "The controller clicks briefly once it is ready."
msgstr "De controller klikt kort zodra hij klaar is."

msgctxt "#30316"
msgid "Disconnect when unused"
msgstr "Loskoppelen bij niet-gebruik"

msgctxt "#30317"
msgid "Disconnects a controller after this time without input to save its battery. Press any button to reconnect."
msgstr "Koppelt een controller los na deze tijd zonder invoer om de batterij te sparen. Druk op een knop om opnieuw te verbinden."

msgctxt "#30320"
msgid "Never"
msgstr "Nooit"

msgctxt "#30321"
msgid "After 5 minutes"
msgstr "Na 5 minuten"

msgctxt "#30322"
msgid "After 10 minutes"
msgstr "Na 10 minuten"

msgctxt "#30323"
msgid "After 15 minutes"
msgstr "Na 15 minuten"

msgctxt "#30324"
msgid "After 30 minutes"
msgstr "Na 30 minuten"

msgctxt "#30325"
msgid "After 60 minutes"
msgstr "Na 60 minuten"

msgctxt "#30330"
msgid "Bluetooth adapter"
msgstr "Bluetooth-adapter"

msgctxt "#30331"
msgid "Leave empty to use the first adapter. Only needed with more than one adapter, e.g. hci1 for a USB stick."
msgstr "Leeg laten om de eerste adapter te gebruiken. Alleen nodig bij meerdere adapters, bijv. hci1 voor een USB-stick."

msgctxt "#30400"
msgid "Kodi"
msgstr "Kodi"

msgctxt "#30401"
msgid "Notifications"
msgstr "Meldingen"

msgctxt "#30410"
msgid "Show notifications"
msgstr "Meldingen tonen"

msgctxt "#30411"
msgid "Shows a short message when a controller connects or disconnects. Errors are always shown."
msgstr "Toont een korte melding wanneer een controller verbindt of loskoppelt. Fouten worden altijd getoond."

