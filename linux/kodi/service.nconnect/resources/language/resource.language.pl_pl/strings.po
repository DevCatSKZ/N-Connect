msgstr "Otwórz Ustawienia LibreELEC > Bluetooth i włącz go"

msgctxt "#30610"
msgid "No Bluetooth adapter"
msgstr "Brak adaptera Bluetooth"

msgctxt "#30611"
msgid "Plug in a Bluetooth adapter or enable the built-in one in the LibreELEC settings"
msgstr "Podłącz adapter Bluetooth lub włącz wbudowany w ustawieniach LibreELEC"

msgctxt "#30612"
msgid "N-Connect is not running"
msgstr "N-Connect nie działa"

msgctxt "#30613"
msgid "Select to restart. If it keeps stopping, run the diagnostics."
msgstr "Wybierz, aby uruchomić ponownie. Jeśli nadal się zatrzymuje, uruchom diagnostykę."

msgctxt "#30614"
msgid "Disconnect all controllers"
msgstr "Rozłącz wszystkie kontrolery"

msgctxt "#30615"
