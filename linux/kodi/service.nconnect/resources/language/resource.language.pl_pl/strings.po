msgid "charging"
msgstr "ładowanie"

msgctxt "#30603"
msgid "{0} updates/s"
msgstr "{0} aktualizacji/s"

msgctxt "#30604"
msgid "No controller connected"
msgstr "Brak połączonego kontrolera"

msgctxt "#30605"
msgid "Press SYNC (Switch 2) or the pairing button (other controllers). Already paired: press any button."
msgstr "Naciśnij SYNC (Switch 2) lub przycisk parowania (inne kontrolery). Już sparowany: naciśnij dowolny przycisk."

msgctxt "#30606"
msgid "{0} found"
msgstr "Znaleziono {0}"

msgctxt "#30607"
msgid "Paired with another device – press SYNC to use it here"
msgstr "Sparowany z innym urządzeniem – naciśnij SYNC, aby używać go tutaj"

msgctxt "#30608"
