msgid "No controller connected"
msgstr "Nessun controller connesso"

msgctxt "#30605"
msgid "Press SYNC (Switch 2) or the pairing button (other controllers). Already paired: press any button."
msgstr "Premi SYNC (Switch 2) o il tasto di associazione (altri controller). Già associato: premi un tasto qualsiasi."

msgctxt "#30606"
msgid "{0} found"
msgstr "{0} trovato"

msgctxt "#30607"
