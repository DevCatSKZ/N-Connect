msgstr "Il Bluetooth è disattivato"

msgctxt "#30609"
msgid "Open LibreELEC settings > Bluetooth and enable it"
msgstr "Apri Impostazioni LibreELEC > Bluetooth e attivalo"

msgctxt "#30610"
msgid "No Bluetooth adapter"
msgstr "Nessun adattatore Bluetooth"

msgctxt "#30611"
msgid "Plug in a Bluetooth adapter or enable the built-in one in the LibreELEC settings"
msgstr "Collega un adattatore Bluetooth o attiva quello integrato nelle impostazioni di LibreELEC"

msgctxt "#30612"
msgid "N-Connect is not running"
msgstr "N-Connect non è in esecuzione"

msgctxt "#30613"
msgid "Select to restart. If it keeps stopping, run the diagnostics."
msgstr "Seleziona per riavviare. Se continua a fermarsi, esegui la diagnostica."

msgctxt "#30614"
msgid "Disconnect all controllers"
msgstr "Disconnetti tutti i controller"

