msgstr "Diagnostica di N-Connect"

msgctxt "#30623"
msgid "[B]Everything is ready.[/B] Press SYNC on a controller to connect it."
msgstr "[B]Tutto pronto.[/B] Premi SYNC su un controller per collegarlo."

msgctxt "#30624"
msgid "[B]Something is missing[/B] – see the red entries below."
msgstr "[B]Manca qualcosa[/B] – vedi le voci in rosso."

msgctxt "#30625"
msgid "The log is empty."
msgstr "Il registro è vuoto."

msgctxt "#30626"
msgid "Serial number"
msgstr "Numero di serie"

msgctxt "#30627"
