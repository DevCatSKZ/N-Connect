<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests für die Windows-App: reine Entscheidungen (Gerätebaum, Kodi-status.json, Einstellungen) ohne Controller,
       ohne Fenster und ohne virtuelle Controller. Gleiches Ziel wie Switch2Pro.Bridge, damit deren interne Klassen
       erreichbar sind (InternalsVisibleTo). -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Switch2Pro.Bridge\Switch2Pro.Bridge.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
