<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Firma, Produkt und Copyright kommen aus Directory.Build.props.
         Version des nächsten Releases (Einstellungsfenster, Renders): vor jedem Release-Tag hochzählen. Der Build-Workflow
         setzt beim Release die Version des Tags; Builds ohne Tag werden zur Vorabversion „<Version>-ci.<Lauf>“. -->
    <Version>1.0.23</Version>
    <OutputType>WinExe</OutputType>
    <!-- 22621 = Windows 11 22H2 SDK (für schnellere BLE-Verbindungsparameter); läuft ab Windows 10 2004. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>SKZ-Connect</AssemblyName>
    <RootNamespace>Switch2Pro.Bridge</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>SKZ-Connect.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>
  <ItemGroup>
    <!-- Unit-Tests für die reinen Entscheidungen (Gerätebaum, Kodi-status.json) ohne Controller. -->
    <InternalsVisibleTo Include="Switch2Pro.Bridge.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fenstersymbol mit allen Größen (das Programm-Icon allein liefert nur 32 px). -->
    <EmbeddedResource Include="SKZ-Connect.ico" LogicalName="SKZ-Connect.ico" />
    <EmbeddedResource Include="SKZ-Connect.png" LogicalName="SKZ-Connect.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Switch2Pro.Protocol\Switch2Pro.Protocol.csproj" />
  </ItemGroup>
</Project>
