<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Company>devcatskz</Company>
    <Authors>devcatskz</Authors>
    <Product>N-Connect</Product>
    <Copyright>© devcatskz</Copyright>
    <!-- Angezeigte Version (Einstellungsfenster, Renders). Vor jedem Release-Tag hochzählen;
         der Build-Workflow setzt sie beim Veröffentlichen ohnehin per -p:Version=<Tag>. -->
    <Version>1.0.11</Version>
    <OutputType>WinExe</OutputType>
    <!-- 22621 = Windows 11 22H2 SDK (für schnellere BLE-Verbindungsparameter); läuft ab Windows 10 2004. -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>N-Connect</AssemblyName>
    <RootNamespace>Switch2Pro.Bridge</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>N-Connect.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fenstersymbol mit allen Größen (das Programm-Icon allein liefert nur 32 px). -->
    <EmbeddedResource Include="N-Connect.ico" LogicalName="N-Connect.ico" />
    <EmbeddedResource Include="N-Connect.png" LogicalName="N-Connect.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Switch2Pro.Protocol\Switch2Pro.Protocol.csproj" />
  </ItemGroup>
</Project>
